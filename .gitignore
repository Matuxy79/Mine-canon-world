# Local Minecraft runtime state and preferences
/logs/
/crash-reports/
/options.txt
/optionsof.txt
/usercache.json
**/session.lock

# Player-specific world progress
/saves/**/playerdata/
/saves/**/advancements/
/saves/**/stats/

# Backups and incomplete downloads
**/level.dat_old
*.crdownload
*.part
*.tmp

# Keep third-party binaries local until redistribution rights are verified
*.jar

# Exception: track the local mod base folder via Git LFS (owner-authorized)
!mods-1.20.1-base/**
mods-1.20.1-base/**/*.crdownload

# Exception: track the in-game Mine Canon mod source and built jar (owner-authored) via Git LFS
!mod/**
mod/**/run/
mod/**/build/
mod/**/.gradle/

# Operating-system metadata
Thumbs.db
Desktop.ini
.DS_Store

# Local desktop launcher preferences and diagnostics
/launcher/launcher.properties
/launcher/forge-installer.log
/*.jar.log
/launcher/.build/
/launcher/dist/
*.class

# Generated MineCanon build output (see launcher/Build-MineCanon.ps1)
/launcher/build*/
/launcher/bin/
/launcher/probe.tmp
/MineCanon.lnk

# VS Code extension packaging output
*.vsix
