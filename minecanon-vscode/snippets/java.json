{
  "Forge mod entry class (MineCanon style)": {
    "prefix": "mcmod",
    "description": "Forge 1.20.1 @Mod entry point with keybind + client tick, like minecanon-ui's MineCanonMod",
    "body": [
      "package ${1:minecanon};",
      "",
      "import com.mojang.blaze3d.platform.InputConstants;",
      "import net.minecraft.client.KeyMapping;",
      "import net.minecraft.client.Minecraft;",
      "import net.minecraftforge.api.distmarker.Dist;",
      "import net.minecraftforge.client.event.RegisterKeyMappingsEvent;",
      "import net.minecraftforge.common.MinecraftForge;",
      "import net.minecraftforge.event.TickEvent;",
      "import net.minecraftforge.eventbus.api.SubscribeEvent;",
      "import net.minecraftforge.fml.common.Mod;",
      "import org.lwjgl.glfw.GLFW;",
      "",
      "/** Entry point: registers the ${2:O} keybind that opens the in-game UI. */",
      "@Mod(${3:MineCanonMod}.ID)",
      "public class ${3:MineCanonMod} {",
      "    public static final String ID = \"${4:minecanon}\";",
      "    public static KeyMapping openUi;",
      "",
      "    public ${3:MineCanonMod}() {",
      "        MinecraftForge.EVENT_BUS.register(this);",
      "    }",
      "",
      "    @Mod.EventBusSubscriber(modid = ID, value = Dist.CLIENT, bus = Mod.EventBusSubscriber.Bus.MOD)",
      "    public static class ClientEvents {",
      "        @SubscribeEvent",
      "        public static void onRegisterKeys(RegisterKeyMappingsEvent event) {",
      "            ${3:MineCanonMod}.openUi = new KeyMapping(\"key.${4:minecanon}.open\", InputConstants.Type.KEYSYM, GLFW.GLFW_KEY_${2:O}, \"key.categories.${4:minecanon}\");",
      "            event.register(${3:MineCanonMod}.openUi);",
      "        }",
      "    }",
      "",
      "    @SubscribeEvent",
      "    public void onClientTick(TickEvent.ClientTickEvent event) {",
      "        if (event.phase != TickEvent.Phase.END) return;",
      "        Minecraft mc = Minecraft.getInstance();",
      "        if (openUi != null && mc.screen == null && mc.player != null) {",
      "            while (openUi.consumeClick()) {",
      "                mc.setScreen(new ${5:CanonScreen}());",
      "            }",
      "        }",
      "    }",
      "}"
    ]
  },
  "In-game screen (CanonScreen style)": {
    "prefix": "mcscreen",
    "description": "Forge 1.20.1 Screen with dark canon panel, Done button and pause, like CanonScreen",
    "body": [
      "import net.minecraft.client.gui.GuiGraphics;",
      "import net.minecraft.client.gui.components.Button;",
      "import net.minecraft.client.gui.screens.Screen;",
      "import net.minecraft.network.chat.Component;",
      "",
      "/** ${1:Describe the screen here.} */",
      "public class ${2:Canon}Screen extends Screen {",
      "    private static final int BG = 0xF50C1115, TEXT = 0xFFF6F1E6, MUTED = 0xFFA4A7AD, ACCENT = 0xFFF57C2C;",
      "",
      "    public ${2:Canon}Screen() {",
      "        super(Component.literal(\"${3:Mine Canon}\"));",
      "    }",
      "",
      "    @Override",
      "    protected void init() {",
      "        super.init();",
      "        this.addRenderableWidget(Button.builder(Component.literal(\"Done\"), b -> onClose())",
      "            .bounds(this.width - 90, this.height - 40, 70, 20).build());",
      "    }",
      "",
      "    @Override",
      "    public void render(GuiGraphics g, int mouseX, int mouseY, float partialTick) {",
      "        g.fill(0, 0, this.width, this.height, BG);",
      "        super.render(g, mouseX, mouseY, partialTick);",
      "        g.drawString(this.font, \"${3:Mine Canon}\", 22, 20, ACCENT);",
      "    }",
      "",
      "    @Override",
      "    public boolean isPauseScreen() { return true; }",
      "}"
    ]
  },
  "Forge keybind registration": {
    "prefix": "mckeybind",
    "description": "Register a client keybind via RegisterKeyMappingsEvent (Forge 1.20.1)",
    "body": [
      "public static final KeyMapping ${1:OPEN_CANON} =",
      "    new KeyMapping(\"key.${2:minecanon}.${3:open}\", InputConstants.Type.KEYSYM, GLFW.GLFW_KEY_${4:O}, \"key.categories.${2:minecanon}\");",
      "",
      "@SubscribeEvent",
      "public static void onRegisterKeys(RegisterKeyMappingsEvent event) {",
      "    event.register(${1:OPEN_CANON});",
      "}"
    ]
  }
}